{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "checkJs": true, // 开启对 JS 文件的类型检查
    "jsx": "preserve", // 如果有 jsx，保留 jsx 语法
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".", // 基础路径，方便相对路径解析
    "paths": {
      "@/*": ["src/*"] // 路径别名示例
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}

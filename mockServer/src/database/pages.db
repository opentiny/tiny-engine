{"name":"Cart","id":"4MyTSXLucYzgzZTk","app":"1","route":"Cart","page_content":{"componentName":"Page","css":".cart-container {\n  display: flex;\n  flex-direction: column;\n  min-height: 100vh;\n  padding-bottom: 113px;\n  background-color: #f5f5f5;\n}\n.notice-bar {\n  padding: 10px 20px;\n  background-color: #fff5f5;\n  text-align: center;\n}\n.notice-text {\n  color: #f07373;\n  font-size: 16px;\n}\n.empty-cart {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  padding-bottom: 64px;\n}\n.empty-image {\n  width: 128px;\n  height: 128px;\n  margin-bottom: 20px;\n}\n.empty-text {\n  color: #999;\n  font-size: 18px;\n  margin-bottom: 32px;\n}\n.go-shopping-btn {\n  width: 192px;\n  height: 51px;\n  line-height: 51px;\n  text-align: center;\n  background-color: #f07373;\n  color: #fff;\n  border-radius: 26px;\n  font-size: 18px;\n}\n.cart-content {\n  flex: 1;\n}\n.store-info {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 20px;\n  background-color: #fff;\n  margin-bottom: 13px;\n}\n.store-name {\n  font-size: 20px;\n  font-weight: bold;\n}\n.store-delivery {\n  font-size: 16px;\n  color: #999;\n}\n.cart-list {\n  background-color: #fff;\n  padding: 0 20px;\n}\n.cart-item {\n  display: flex;\n  padding: 20px 0;\n  border-bottom: 1px solid #f5f5f5;\n}\n.food-image {\n  width: 126px;\n  height: 126px;\n  border-radius: 5px;\n  margin-right: 13px;\n}\n.item-info {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n}\n.item-name-wrap {\n  display: flex;\n  justify-content: space-between;\n  margin-bottom: 6px;\n}\n.item-name {\n  font-size: 18px;\n  font-weight: bold;\n  flex: 1;\n}\n.delete-btn {\n  width: 26px;\n  height: 26px;\n  text-align: center;\n  line-height: 24px;\n  font-size: 26px;\n  color: #999;\n}\n.item-desc {\n  font-size: 16px;\n  color: #999;\n  margin-bottom: 13px;\n}\n.item-bottom {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n.item-price {\n  font-size: 20px;\n  color: #f07373;\n  font-weight: bold;\n}\n.item-actions {\n  display: flex;\n  align-items: center;\n}\n.btn {\n  width: 32px;\n  height: 32px;\n  border-radius: 50%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n.minus {\n  background-color: #f5f5f5;\n}\n.plus {\n  background-color: #f07373;\n}\n.btn-icon {\n  width: 20px;\n  height: 20px;\n}\n.count {\n  min-width: 26px;\n  text-align: center;\n  margin: 0 10px;\n  font-size: 18px;\n}\n.fee-section {\n  margin-top: 13px;\n  padding: 13px 20px;\n  background-color: #fff;\n}\n.fee-item {\n  display: flex;\n  justify-content: space-between;\n  padding: 10px 0;\n  font-size: 18px;\n  color: #333;\n}\n.discount {\n  color: #f07373;\n}\n.checkout-bar {\n  position: fixed;\n  left: 0;\n  right: 0;\n  bottom: 60px;\n  height: 64px;\n  display: flex;\n  align-items: center;\n  background-color: #fff;\n  border-top: 1px solid #f5f5f5;\n}\n.price-info {\n  flex: 1;\n  padding-left: 20px;\n  display: flex;\n  align-items: baseline;\n}\n.price-label {\n  font-size: 18px;\n  color: #333;\n  margin-right: 6px;\n}\n.total-price {\n  font-size: 24px;\n  color: #f07373;\n  font-weight: bold;\n}\n.checkout-btn {\n  width: 154px;\n  height: 41px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  color: #fff;\n  font-size: 20px;\n}\n.active {\n  background-color: #f07373;\n}\n.disabled {\n  background-color: #cccccc;\n}\n","props":{"style":"padding-bottom: 60px;width:100%;","themeColor":"#fff5f5"},"lifeCycles":{},"children":[{"componentName":"HarmonyView","props":{"className":" cart-container"},"children":[{"componentName":"HarmonyView","props":{"className":" notice-bar"},"children":[{"componentName":"HarmonyText","props":{"style":"display: inline-block;","className":" notice-text","text":"满30减5，还差0.00元享受优惠"},"children":[],"id":"45221326"}],"id":"62485622","condition":{"type":"JSExpression","value":"this.state.cartItems.leng
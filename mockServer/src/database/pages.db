ice":32.9,"image":"https://tinyengine-assets.obs.cn-north-4.myhuaweicloud.com/files/harmony/images/food/beef-burger.jpg","monthlySales":218}]},{"name":"单人套餐","foods":[{"id":3,"name":"美式炸鸡套餐","description":"2块炸鸡 + 中薯条 + 中可乐","price":36.9,"image":"https://tinyengine-assets.obs.cn-north-4.myhuaweicloud.com/files/harmony/images/food/chicken-combo.jpg","monthlySales":196},{"id":4,"name":"鸡肉卷套餐","description":"鸡肉卷 + 中薯条 + 中可乐","price":27.9,"image":"https://tinyengine-assets.obs.cn-north-4.myhuaweicloud.com/files/harmony/images/food/roll-combo.jpg","monthlySales":176}]},{"name":"家庭套餐","foods":[{"id":5,"name":"欢乐家庭桶","description":"3块炸鸡 + 2个汉堡 + 2份薯条 + 2杯可乐","price":88.9,"image":"https://tinyengine-assets.obs.cn-north-4.myhuaweicloud.com/files/harmony/images/food/family-combo.jpg","monthlySales":95}]},{"name":"小食","foods":[{"id":6,"name":"薯条","description":"香脆可口的薯条","price":8.9,"image":"https://tinyengine-assets.obs.cn-north-4.myhuaweicloud.com/files/harmony/images/food/fries.jpg","monthlySales":355},{"id":7,"name":"洋葱圈","description":"香脆可口的洋葱圈","price":9.9,"image":"https://tinyengine-assets.obs.cn-north-4.myhuaweicloud.com/files/harmony/images/food/onion-rings.jpg","monthlySales":135}]},{"name":"饮料","foods":[{"id":8,"name":"可乐","description":"百事可乐","price":6.9,"image":"https://tinyengine-assets.obs.cn-north-4.myhuaweicloud.com/files/harmony/images/food/cola.jpg","monthlySales":499},{"id":9,"name":"雪碧","description":"清爽雪碧","price":6.9,"image":"https://tinyengine-assets.obs.cn-north-4.myhuaweicloud.com/files/harmony/images/food/sprite.jpg","monthlySales":287}]}],"cartItems":[]},"methods":{},"utils":[],"bridge":[],"inputs":[],"outputs":[],"fileName":"OrderMenu","id":"body"},"tenant":1,"isBody":false,"parentId":"KCxUnHObOvsOKzeN","depth":0,"isPage":true,"isDefault":false,"group":"staticPages","occupier":{"id":86,"username":"开发者","email":"developer@lowcode.com","confirmationToken":"dfb2c162-351f-4f44-ad5f-8998","is_admin":true},"isHome":false,"message":"Page auto save","_id":"P
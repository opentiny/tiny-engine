{
    "componentName": "Page",
    "css": ".content {\n  padding-bottom: 19px;\n}\n\n.search-box {\n  padding: 13px 19px;\n  background-color: #f07373;\n}\n\n.search-input {\n  display: flex;\n  align-items: center;\n  background-color: #fff;\n  border-radius: 30px;\n  padding: 6px 13px;\n}\n\n.search-icon {\n  width: 23px;\n  height: 23px;\n  margin-right: 6px;\n}\n\n.search-input input {\n  flex: 1;\n  font-size: 18px;\n}\n\n.banner {\n  width: 100%;\n  height: 192px;\n}\n\n.banner-image {\n  width: 100%;\n  height: 100%;\n}\n\n.category-section {\n  display: flex;\n  padding: 19px 13px;\n  justify-content: space-between;\n  background-color: #fff;\n  margin-bottom: 13px;\n}\n\n.category-item {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  width: 113px;\n}\n\n.category-icon {\n  width: 51px;\n  height: 51px;\n  margin-bottom: 6px;\n}\n\n.category-name {\n  font-size: 16px;\n  color: #333;\n}\n\n.section-title {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 13px 19px;\n  font-size: 20px;\n  font-weight: bold;\n  color: #333;\n  background-color: #fff;\n  border-bottom: 1px solid #f5f5f5;\n}\n\n.more {\n  font-size: 16px;\n  color: #999;\n  font-weight: normal;\n}\n\n.promotion-section {\n  padding: 0 19px;\n  background-color: #fff;\n  margin-bottom: 13px;\n}\n\n.promotion-item {\n  display: flex;\n  padding: 13px 0;\n  border-bottom: 1px solid #f5f5f5;\n}\n\n.promotion-image {\n  width: 151px;\n  height: 113px;\n  margin-right: 13px;\n  border-radius: 5px;\n}\n\n.promotion-info {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  justify-content: space-between;\n}\n\n.promotion-title {\n  font-size: 18px;\n  font-weight: bold;\n  color: #333;\n}\n\n.promotion-desc {\n  font-size: 16px;\n  color: #999;\n}\n\n.recommended-section {\n  padding: 13px 19px;\n  background-color: #fff;\n}\n\n.food-item {\n  display: flex;\n  padding: 13px 0;\n  border-bottom: 1px solid #f5f5f5;\n}\n\n.food-image {\n  width: 115px;\n  height: 115px;\n  margin-right: 13px;\n  border-radius: 5px;\n}\n\n.food-info {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  position: relative;\n}\n\n.food-name {\n  font-size: 19px;\n  font-weight: bold;\n  margin-bottom: 6px;\n}\n\n.food-price {\n  font-size: 19px;\n  color: #f07373;\n  font-weight: bold;\n  margin-bottom: 6px;\n}\n\n.food-tags {\n  display: flex;\n  flex-wrap: wrap;\n}\n\n.tag {\n  padding: 3px 8px;\n  background-color: #fff5f5;\n  color: #f07373;\n  font-size: 13px;\n  margin-right: 6px;\n  margin-bottom: 6px;\n  border-radius: 13px;\n}\n\n.add-to-cart {\n  position: absolute;\n  right: 0;\n  bottom: 0;\n  width: 38px;\n  height: 38px;\n  background-color: #f07373;\n  border-radius: 50%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.add-cart-icon {\n  width: 23px;\n  height: 23px;\n}\n",

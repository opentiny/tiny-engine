{
    "componentName": "Page",
    "css": ".my-container {\n  min-height: 100vh;\n  background-color: #f5f5f5;\n  padding-bottom: 25.6px;\n}\n\n.user-info-box {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 25.6px 19.2px;\n  background-color: #f07373;\n}\n\n.user-info {\n  display: flex;\n  align-items: center;\n}\n\n.avatar {\n  width: 76.8px;\n  height: 76.8px;\n  border-radius: 50%;\n  border: 4rpx solid rgba(255, 255, 255, 0.4);\n}\n\n.user-detail {\n  margin-left: 12.8px;\n  color: #fff;\n}\n\n.username {\n  font-size: 21.76px;\n  font-weight: bold;\n  margin-bottom: 6.4px;\n}\n\n.user-id {\n  font-size: 15.36px;\n  opacity: 0.8;\n}\n\n.setting-icon {\n  width: 38.4px;\n  height: 38.4px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.icon-setting {\n  color: #fff;\n  font-size: 25.6px;\n}\n.icon-setting:before {\n  content: '\\e60d';\n}\n\n.card-box {\n  margin: 12.8px 19.2px;\n  height: 102.4px;\n  border-radius: 10.24px;\n  overflow: hidden;\n  position: relative;\n}\n\n.card-bg {\n  position: absolute;\n  width: 100%;\n  height: 100%;\n  z-index: 1;\n}\n\n.card-info {\n  position: relative;\n  z-index: 2;\n  padding: 19.2px;\n  color: #fff;\n}\n\n.card-title {\n  font-size: 20.48px;\n  font-weight: bold;\n  margin-bottom: 6.4px;\n}\n\n.card-desc {\n  font-size: 15.36px;\n  opacity: 0.8;\n}\n\n.order-section {\n  background-color: #fff;\n  margin-bottom: 12.8px;\n}\n.menu-section {\n  background-color: #fff;\n  margin-bottom: 12.8px;\n}\n\n.section-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 19.2px;\n  border-bottom: 1px solid #f5f5f5;\n  font-size: 19.2px;\n  font-weight: bold;\n}\n\n.more {\n  display: flex;\n  align-items: center;\n  font-size: 15.36px;\n  font-weight: normal;\n  color: #999;\n}\n\n.icon-arrow-right {\n  font-size: 15.36px;\n  margin-left: 6.4px;\n}\n\n.icon-arrow-right:before {\n  content: '\\e644';\n}\n\n.order-types {\n  display: flex;\n  align-items: center;\n  padding: 19.2px 0;\n}\n\n.order-type-item {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n}\n\n.order-icon-wrapper {\n  width: 51.2px;\n  height: 51.2px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  position: relative;\n}\n\n.order-icon {\n  width: 30.72px;\n  height: 30.72px;\n}\n\n.badge {\n  position: absolute;\n  top: -6.4px;\n  right: -6.4px;\n  background-color: #ff0000;\n  color: #fff;\n  font-size: 12.8px;\n  min-width: 19.2px;\n  height: 19.2px;\n  padding: 0 3.84px;\n  border-radius: 9.6px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.order-type-text {\n  font-size: 16.64px;\n  color: #333;\n  margin-top: 6.4px;\n}\n\n.menu-item {\n  display: flex;\n  align-items: center;\n  padding: 19.2px;\n  border-bottom: 1px solid #f5f5f5;\n}\n\n.menu-item:last-child {\n  border-bottom: none;\n}\n\n.menu-icon {\n  width: 25.6px;\n  height: 25.6px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  margin-right: 12.8px;\n}\n\n.menu-icon .iconfont {\n  font-size: 23.04px;\n  color: #f07373;\n}\n\n.menu-text {\n  flex: 1;\n  font-size: 17.92px;\n  color: #333;\n}\n\n.menu-item .icon-arrow-right {\n  color: #ccc;\n}\n\n.logout-btn {\n  margin: 25.6px 19.2px;\n  height: 57.6px;\n  line-height: 57.6px;\n  text-align: center;\n  background-color: #fff;\n  border-radius: 28.8px;\n  font-size: 19.2px;\n  color: #f07373;\n}\n",

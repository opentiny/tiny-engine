{
    "componentName": "Page",
    "css": ".menu-container {\n  display: flex;\n  flex-direction: column;\n  height: 100vh;\n}\n.search-box {\n  padding: 12.8px 19.2px;\n  background-color: #f07373;\n}\n.search-input {\n  display: flex;\n  align-items: center;\n  background-color: #fff;\n  border-radius: 19.2px;\n  padding: 6.4px 12.8px;\n}\n.search-icon {\n  width: 23.04px;\n  height: 23.04px;\n  margin-right: 6.4px;\n}\n.search-input input {\n  flex: 1;\n  font-size: 17.92px;\n}\n.menu-content {\n  display: flex;\n  flex: 1;\n  overflow: hidden;\n}\n\n/*左侧分类列表*/\n.category-list {\n  width: 115.2px;\n  height: 100%;\n  background-color: #f5f5f5;\n}\n.category-item {\n  height: 64px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 16.64px;\n  color: #333;\n  position: relative;\n  text-align: center;\n  padding: 0 6.4px;\n}\n.active {\n  color: #f07373;\n  background-color: #fff;\n  font-weight: bold;\n}\n.category-item.active::before {\n  content: '';\n  position: absolute;\n  left: 0;\n  top: 50%;\n  transform: translateY(-50%);\n  width: 3.84px;\n  height: 25.6px;\n  background-color: #f07373;\n}\n\n/*右侧菜品列表*/\n.food-list {\n  flex: 1;\n  height: 100%;\n  padding: 0 12.8px;\n}\n.category-title {\n  height: 51.2px;\n  line-height: 51.2px;\n  font-size: 17.92px;\n  color: #333;\n  font-weight: bold;\n  border-bottom: 1px solid #f5f5f5;\n}\n.food-item {\n  display: flex;\n  padding: 15.36px 0;\n  border-bottom: 1px solid #f5f5f5;\n}\n.food-image {\n  width: 96px;\n  height: 96px;\n  margin-right: 12.8px;\n  border-radius: 5.12px;\n}\n.food-info {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  justify-content: space-between;\n}\n.food-name {\n  font-size: 19.2px;\n  font-weight: bold;\n  color: #333;\n}\n.food-desc {\n  font-size: 15.36px;\n  color: #999;\n  margin: 6.4px 0;\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n.food-sales {\n  font-size: 14.08px;\n  color: #999;\n  margin-bottom: 6.4px;\n}\n.food-price-box {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n.food-price {\n  font-size: 19.2px;\n  color: #f07373;\n  font-weight: bold;\n}\n.food-actions {\n  display: flex;\n  align-items: center;\n}\n.minus,\n.add {\n  width: 32px;\n  height: 32px;\n  background-color: #f5f5f5;\n  border-radius: 50%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n.add {\n  background-color: #f07373;\n}\n.btn-icon {\n  width: 20.48px;\n  height: 20.48px;\n}\n.count {\n  margin: 0 10.24px;\n  font-size: 17.92px;\n  min-width: 19.2px;\n  text-align: center;\n}\n\n/*购物车悬浮按钮*/\n.cart-float-box {\n  position: fixed;\n  left: 0;\n  right: 0;\n  bottom: 60px;\n  height: 64px;\n  margin: 0 19.2px;\n  background-color: #333;\n  border-radius: 32px;\n  display: flex;\n  align-items: center;\n  z-index: 999;\n}\n.cart-icon-box {\n  position: relative;\n  width: 64px;\n  height: 64px;\n}\n.cart-icon {\n  position: absolute;\n  top: -12.8px;\n  left: 0px;\n  width: 40px;\n  height: 40px;\n  background-color: #333;\n  border-radius: 50%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  border: 6.4px solid #333;\n  padding: 12.8px;\n}\n.badge {\n  position: absolute;\n  top: 0;\n  right: 12.8px;\n  min-width: 19.2px;\n  height: 19.2px;\n  padding: 0 3.84px;\n  background-color: #ff0000;\n  color: #fff;\n  font-size: 12.8px;\n  border-radius: 9.6px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n.cart-info {\n  flex: 1;\n  padding-left: 12.8px;\n}\n.cart-price {\n  color: #fff;\n  font-size: 20.48px;\n  font-weight: bold;\n}\n.checkout-btn {\n  width: 128px;\n  height: 100%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  color: #fff;\n  font-size: 20.48px;\n  background-color: #f07373;\n  border-radius: 0 32px 32px 0;\n}\n",

    "css": ".order-container {\n  min-height: 100vh;\n  background-color: #f5f5f5;\n  padding-bottom: 12.8px;\n}\n\n.empty-order {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  padding-top: 128px;\n}\n\n.empty-image {\n  width: 128px;\n  height: 128px;\n  margin-bottom: 19.2px;\n}\n\n.empty-text {\n  color: #999;\n  font-size: 17.92px;\n  margin-bottom: 50rpx;\n}\n\n.go-shopping-btn {\n  width: 192px;\n  height: 51.2px;\n  line-height: 51.2px;\n  text-align: center;\n  background-color: #f07373;\n  color: #fff;\n  border-radius: 25.6px;\n  font-size: 17.92px;\n}\n\n.order-list {\n  padding: 12.8px;\n}\n\n.order-item {\n  background-color: #fff;\n  border-radius: 6.4px;\n  margin-bottom: 12.8px;\n  overflow: hidden;\n}\n\n.order-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 12.8px 19.2px;\n  border-bottom: 1px solid #f5f5f5;\n}\n\n.store-name {\n  font-size: 17.92px;\n  font-weight: bold;\n}\n\n.order-status {\n  font-size: 16.64px;\n}\n\n.status-wait {\n  color: #ff9900;\n}\n\n.status-active {\n  color: #f07373;\n}\n\n.status-completed {\n  color: #999;\n}\n\n.status-canceled {\n  color: #999;\n}\n\n.order-content {\n  padding: 12.8px 19.2px;\n  border-bottom: 1px solid #f5f5f5;\n}\n\n.food-info {\n  display: flex;\n  margin-bottom: 12.8px;\n}\n\n.food-image {\n  width: 76.8px;\n  height: 76.8px;\n  border-radius: 5.12px;\n  margin-right: 12.8px;\n}\n\n.food-desc {\n  flex: 1;\n}\n\n.food-summary {\n  font-size: 17.92px;\n  margin-bottom: 6.4px;\n}\n\n.food-count {\n  font-size: 15.36px;\n  color: #999;\n}\n\n.order-price-info {\n  display: flex;\n  justify-content: flex-end;\n}\n\n.amount {\n  font-size: 16.64px;\n  color: #333;\n}\n\n.price {\n  font-size: 19.2px;\n  color: #f07373;\n  font-weight: bold;\n  margin-left: 6.4px;\n}\n\n.order-footer {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 12.8px 19.2px;\n}\n\n.order-time {\n  font-size: 15.36px;\n  color: #999;\n}\n\n.order-actions {\n  display: flex;\n}\n\n.action-btn {\n  margin-left: 12.8px;\n  font-size: 15.36px;\n  min-width: 102.4px;\n  height: 38.4px;\n  line-height: 38.4px;\n  border-radius: 19.2px;\n  padding: 0 19.2px;\n}\n\n.action-btn.plain {\n  color: #333;\n  border: 1px solid #ddd;\n  background-color: #fff;\n}\n\n.action-btn.primary {\n  color: #fff;\n  background-color: #f07373;\n  border: 1px solid #f07373;\n}\n",

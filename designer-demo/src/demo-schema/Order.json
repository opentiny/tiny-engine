    "methods": {
      "getStatusText": {
        "type": "JSFunction",
        "value": "function getStatusText(status) {\n  const statusMap = {\n    WAIT_PAY: '待支付',\n    WAIT_DELIVERY: '待配送',\n    DELIVERING: '配送中',\n    COMPLETED: '已完成',\n    CANCELED: '已取消'\n  }\n  return statusMap[status]\n}\n"
      },
      "getFoodSummary": {
        "type": "JSFunction",
        "value": "function getFoodSummary(order) {\n  const foods = order.foods\n  if (foods.length === 0) return ''\n\n  const firstFood = foods[0]\n  if (foods.length === 1) {\n    return firstFood.name\n  } else {\n    return `${firstFood.name} 等 ${foods.length} 件商品`\n  }\n}\n"
      },
      "getTotalCount": {
        "type": "JSFunction",
        "value": "function getTotalCount(order) {\n  return order.foods.reduce((total, food) => total + food.count, 0)\n}\n"
      },
      "formatOrderTime": {
        "type": "JSFunction",
        "value": "function formatOrderTime(intime) {\n  // 简单格式化，实际项目中可以使用日期格式化库\n  const time = new Date(intime)\n  const now = new Date()\n  const today = new Date(now.getFullYear(), now.getMonth(), now.getDate()).getTime()\n  const yesterday = today - 24 * 60 * 60 * 1000\n\n  const orderTime = time.getTime()\n  if (orderTime >= today) {\n    return `今天 ${time.getHours().toString().padStart(2, '0')}:${time.getMinutes().toString().padStart(2, '0')}`\n  } else if (orderTime >= yesterday) {\n    return `昨天 ${time.getHours().toString().padStart(2, '0')}:${time.getMinutes().toString().padStart(2, '0')}`\n  } else {\n    return `${time.getFullYear()}-${(time.getMonth() + 1).toString().padStart(2, '0')}-${time\n      .getDate()\n      .toString()\n      .padStart(2, '0')}`\n  }\n}\n"
      }
    },
